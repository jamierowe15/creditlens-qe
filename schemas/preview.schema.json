{
  "$id": "preview.schema.json",
  "title": "DecisionPreviewResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "riskScore",
    "dtiRatio",
    "apr",
    "monthlyPayment",
    "approvedAmount",
    "reasons",
    "rulesVersion"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "APPROVED",
        "REFERRED",
        "DECLINED"
      ]
    },
    "riskScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "dtiRatio": {
      "type": "number"
    },
    "apr": {
      "type": "number"
    },
    "monthlyPayment": {
      "type": "number"
    },
    "approvedAmount": {
      "type": [
        "number",
        "null"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "reason.schema.json"
      }
    },
    "rulesVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}-v\\d+$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
