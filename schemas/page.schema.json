{
  "$id": "page.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content",
    "page",
    "size",
    "totalElements",
    "totalPages"
  ],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "$ref": "application.schema.json"
      }
    },
    "page": {
      "type": "integer",
      "minimum": 0
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "totalElements": {
      "type": "integer",
      "minimum": 0
    },
    "totalPages": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
