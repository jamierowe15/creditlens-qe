      "type": "integer",
      "minimum": 0
    },
    "referred": {
      "type": "integer",
      "minimum": 0
    },
    "declined": {
      "type": "integer",
      "minimum": 0
    },
    "approvalRatePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
